# Local credentials and runtime artifacts
.env
.env.*
!.env.example
!.env.*.example
**/.env.local
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
*.log

# Journals, trained weights and raw HTTP dumps stay local: they are large and
# they contain request/response payloads that are not published.
*.sqlite
*.joblib
*.sqlite-journal
.matrix-run.lock

# Raw third-party datasets are downloaded, not redistributed. See README.
jev_workbench/scientific/data_sources/
jev_workbench/scientific/data/massive_candidate.json
jev_workbench/scientific/data/t2_candidate.json

# Feishu document exports used while drafting.
jev_workbench/scientific/audits/feishu_*
jev_workbench/scientific/evidence/feishu_*
