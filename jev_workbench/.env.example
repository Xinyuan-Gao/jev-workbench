# Copy to .env.local in this directory; fill in your own keys.
# Leave remote keys empty to use rules or local models only.
JEV_API_URL=https://5yuantoken.org/v1
JEV_API_KEY=
JEV_API_PATH=/chat/completions
JEV_API_PROTOCOL=systemone

GEMINI_API_URL=https://5yuantoken.org/v1
GEMINI_API_KEY=
GEMINI_API_PATH=/chat/completions
# Set an alias supported by your provider; this is the historical run alias.
GEMINI_MODEL=gemini-3.8-flash
